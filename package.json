{
  "name": "phare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phare, assistant vocal personnel en 3D",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/check.mjs",
    "predev:mobile": "node scripts/check.mjs",
    "dev": "concurrently -n serveur,site -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "dev:mobile": "concurrently -n serveur,site -c yellow,cyan \"npm:dev:server\" \"vite --host --mode mobile\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:claude": "node scripts/build-claude.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
